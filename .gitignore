# ===========================
# Godot (src/)
# ===========================
# Godot 4 cache — regenerated on open
src/.godot/
src/*.translation

# Exported builds — regenerated with `--export-release`
src/exports/
src/*.pck
src/*.wasm

# Android build template generated by Godot
src/android/build/
src/android/.gradle/
src/android/local.properties
src/android/.cxx/

# Imported resources cache
src/.import/

# ===========================
# Android Studio / Gradle (linkerApp/)
# ===========================
linkerApp/.gradle/
linkerApp/build/
linkerApp/app/build/
linkerApp/.idea/
linkerApp/local.properties
linkerApp/captures/
linkerApp/*.iml
linkerApp/*.hprof
linkerApp/.kotlin/

# Generated APKs / bundles
*.apk
*.aab
*.ap_
*.dex

# Keystores — NEVER commit these
*.jks
*.keystore
linkerApp/keystore.properties

# Godot Web export copied into Android assets
# Remove/comment this line if you WANT to track the export inside the repo
linkerApp/app/src/main/assets/www/

# ===========================
# OS / Editor junk
# ===========================
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
.idea/
